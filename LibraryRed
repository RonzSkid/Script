local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local Library = {}

Library.Theme = {
    Background = Color3.fromRGB(17, 20, 30), -- recreation / approximation
    Surface = Color3.fromRGB(25, 30, 44),
    SurfaceRaised = Color3.fromRGB(33, 40, 58),
    Accent = Color3.fromRGB(74, 126, 255),
    AccentHover = Color3.fromRGB(95, 143, 255),
    Text = Color3.fromRGB(242, 245, 255),
    MutedText = Color3.fromRGB(165, 174, 196),
    Border = Color3.fromRGB(58, 67, 91),
    Success = Color3.fromRGB(74, 205, 137),
}

local function create(className, properties, parent)
    local instance = Instance.new(className)
    for key, value in pairs(properties or {}) do
        instance[key] = value
    end
    instance.Parent = parent
    return instance
end

local function corner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, parent)
end

local function stroke(parent, color, transparency)
    return create("UIStroke", {
        Color = color or Library.Theme.Border,
        Transparency = transparency or 0,
        Thickness = 1,
    }, parent)
end

local function label(parent, text, size, position, fontSize, color, alignment)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Position = position or UDim2.new(),
        Font = Enum.Font.Gotham,
        Text = tostring(text or ""),
        TextColor3 = color or Library.Theme.Text,
        TextSize = fontSize or 14,
        TextXAlignment = alignment or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function button(parent, text, size, position)
    local item = create("TextButton", {
        AutoButtonColor = false,
        BackgroundColor3 = Library.Theme.SurfaceRaised,
        Size = size,
        Position = position or UDim2.new(),
        Font = Enum.Font.GothamMedium,
        Text = text or "",
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
    }, parent)
    corner(item, 7)
    item.MouseEnter:Connect(function()
        TweenService:Create(item, TweenInfo.new(0.12), {
            BackgroundColor3 = Library.Theme.AccentHover,
        }):Play()
    end)
    item.MouseLeave:Connect(function()
        TweenService:Create(item, TweenInfo.new(0.12), {
            BackgroundColor3 = Library.Theme.SurfaceRaised,
        }):Play()
    end)
    return item
end

local function addList(parent, padding)
    create("UIPadding", {
        PaddingTop = UDim.new(0, padding or 8),
        PaddingBottom = UDim.new(0, padding or 8),
        PaddingLeft = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
    }, parent)
    local layout = create("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, parent)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if parent:IsA("ScrollingFrame") then
            parent.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 18)
        end
    end)
    return layout
end

local function makeControl(parent, height)
    local row = create("Frame", {
        BackgroundColor3 = Library.Theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 38),
    }, parent)
    corner(row, 7)
    return row
end

function Library.CreateWindow(options)
    options = options or {}
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local gui = create("ScreenGui", {
        Name = options.Name or "REXM_UI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui)

    local window = create("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = options.Position or UDim2.fromScale(0.5, 0.5),
        Size = options.Size or UDim2.fromOffset(690, 450),
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, gui)
    corner(window, 12)
    stroke(window, Library.Theme.Border, 0.1)

    local topbar = create("Frame", {
        Name = "Topbar",
        BackgroundColor3 = Library.Theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 64),
    }, window)
    label(topbar, options.Title or "REXM HUB", UDim2.new(1, -110, 0, 27),
        UDim2.fromOffset(18, 7), 20, Library.Theme.Text)
    label(topbar, options.SubTitle or "by : MA7AMD", UDim2.new(1, -110, 0, 20),
        UDim2.fromOffset(19, 34), 12, Library.Theme.MutedText)

    local minimize = button(topbar, "—", UDim2.fromOffset(34, 30), UDim2.new(1, -48, 0, 17))
    local body = create("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 64),
        Size = UDim2.new(1, 0, 1, -64),
    }, window)

    local sidebar = create("ScrollingFrame", {
        Name = "Tabs",
        BackgroundColor3 = Library.Theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 165, 1, 0),
        CanvasSize = UDim2.new(),
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Library.Theme.Accent,
    }, body)
    addList(sidebar, 10)

    local content = create("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 165, 0, 0),
        Size = UDim2.new(1, -165, 1, 0),
    }, body)

    local windowObject = {
        Gui = gui,
        Frame = window,
        Tabs = {},
        _tabButtons = {},
        _selectedTab = nil,
    }

    local minimized = false
    minimize.Activated:Connect(function()
        minimized = not minimized
        body.Visible = not minimized
        window.Size = minimized and UDim2.new(0, 330, 0, 64)
            or (options.Size or UDim2.fromOffset(690, 450))
        minimize.Text = minimized and "+" or "—"
    end)

    function windowObject:CreateTab(tabOptions)
        tabOptions = tabOptions or {}
        local tabName = tabOptions.Name or tabOptions.Title or ("Tab " .. tostring(#self.Tabs + 1))

        local tabButton = button(sidebar, tabName, UDim2.new(1, 0, 0, 36))
        tabButton.TextXAlignment = Enum.TextXAlignment.Left
        tabButton.Text = "   " .. tabName

        local page = create("ScrollingFrame", {
            Name = "Page_" .. tostring(#self.Tabs + 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            Visible = false,
            CanvasSize = UDim2.new(),
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = Library.Theme.Accent,
        }, content)
        addList(page, 10)

        local tabObject = { Button = tabButton, Page = page, Name = tabName }

        function tabObject:CreateSection(sectionOptions)
            sectionOptions = sectionOptions or {}
            local sectionName = type(sectionOptions) == "string" and sectionOptions
                or (sectionOptions.Name or sectionOptions.Title or "Section")

            local section = create("Frame", {
                Name = "Section",
                BackgroundColor3 = Library.Theme.Surface,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 38),
                AutomaticSize = Enum.AutomaticSize.Y,
            }, page)
            corner(section, 8)
            stroke(section, Library.Theme.Border, 0.35)

            label(section, sectionName, UDim2.new(1, -20, 0, 30),
                UDim2.fromOffset(10, 0), 15, Library.Theme.Accent)
            local controls = create("Frame", {
                Name = "Controls",
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(0, 32),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
            }, section)
            local list = addList(controls, 4)
            list.Padding = UDim.new(0, 6)
            controls:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                section.Size = UDim2.new(1, 0, 0, controls.AbsoluteSize.Y + 38)
            end)

            local sectionObject = { Frame = section, Controls = controls }

            function sectionObject:CreateButton(controlOptions)
                controlOptions = controlOptions or {}
                local row = makeControl(controls, 38)
                local textButton = button(row, controlOptions.Name or controlOptions.Text or "Button",
                    UDim2.new(1, -12, 1, -8), UDim2.fromOffset(6, 4))
                textButton.Activated:Connect(function()
                    if controlOptions.Callback then
                        task.spawn(controlOptions.Callback)
                    end
                end)
                return { Instance = textButton }
            end

            function sectionObject:CreateToggle(controlOptions)
                controlOptions = controlOptions or {}
                local row = makeControl(controls, 40)
                label(row, controlOptions.Name or "Toggle", UDim2.new(1, -75, 1, 0),
                    UDim2.fromOffset(10, 0), 13)
                local toggleButton = button(row, "", UDim2.fromOffset(42, 22),
                    UDim2.new(1, -52, 0.5, -11))
                local enabled = controlOptions.Default == true
                local function update()
                    toggleButton.BackgroundColor3 = enabled and Library.Theme.Accent or Library.Theme.SurfaceRaised
                    toggleButton.Text = enabled and "ON" or "OFF"
                end
                update()
                toggleButton.Activated:Connect(function()
                    enabled = not enabled
                    update()
                    if controlOptions.Callback then
                        task.spawn(controlOptions.Callback, enabled)
                    end
                end)
                return {
                    Instance = row,
                    GetValue = function() return enabled end,
                    SetValue = function(value)
                        enabled = value == true
                        update()
                        if controlOptions.Callback then controlOptions.Callback(enabled) end
                    end,
                }
            end

            function sectionObject:CreateSlider(controlOptions)
                controlOptions = controlOptions or {}
                local min = tonumber(controlOptions.Min) or 0
                local max = tonumber(controlOptions.Max) or 100
                local increment = tonumber(controlOptions.Increment) or 1
                if max < min then max = min end
                local value = math.clamp(tonumber(controlOptions.Default) or min, min, max)

                local row = makeControl(controls, 58)
                label(row, controlOptions.Name or "Slider", UDim2.new(1, -70, 0, 24),
                    UDim2.fromOffset(10, 2), 13)
                local valueLabel = label(row, tostring(value), UDim2.fromOffset(58, 24),
                    UDim2.new(1, -66, 0, 2), 12, Library.Theme.MutedText, Enum.TextXAlignment.Right)
                local track = create("Frame", {
                    BackgroundColor3 = Library.Theme.Border,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 10, 0, 35),
                    Size = UDim2.new(1, -20, 0, 7),
                }, row)
                corner(track, 4)
                local fill = create("Frame", {
                    BackgroundColor3 = Library.Theme.Accent,
                    BorderSizePixel = 0,
                    Size = UDim2.new(max == min and 0 or (value - min) / (max - min), 0, 1, 0),
                }, track)
                corner(fill, 4)

                local dragging = false
                local function setFromX(x)
                    local width = math.max(track.AbsoluteSize.X, 1)
                    local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
                    local nextValue = min + (max - min) * alpha
                    nextValue = min + math.floor(((nextValue - min) / math.max(increment, 0.000001)) + 0.5) * increment
                    value = math.clamp(math.floor(nextValue * 10000 + 0.5) / 10000, min, max)
                    valueLabel.Text = tostring(value)
                    fill.Size = UDim2.new(max == min and 0 or (value - min) / (max - min), 0, 1, 0)
                    if controlOptions.Callback then controlOptions.Callback(value) end
                end
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        setFromX(input.Position.X)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        setFromX(input.Position.X)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
                end)
                return {
                    Instance = row,
                    GetValue = function() return value end,
                    SetValue = function(newValue)
                        value = math.clamp(tonumber(newValue) or min, min, max)
                        setFromX(track.AbsolutePosition.X + (max == min and 0 or (value - min) / (max - min)) * track.AbsoluteSize.X)
                    end,
                }
            end

            function sectionObject:CreateDropdown(controlOptions)
                controlOptions = controlOptions or {}
                local optionsList = controlOptions.Options or {}
                local selected = controlOptions.Default
                local row = makeControl(controls, 38)
                local main = button(row, (controlOptions.Name or "Dropdown") .. ": " .. tostring(selected or "Select"),
                    UDim2.new(1, -10, 1, -8), UDim2.fromOffset(5, 4))
                local optionFrame = create("Frame", {
                    BackgroundColor3 = Library.Theme.SurfaceRaised,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 0, 1, 3),
                    Size = UDim2.new(1, 0, 0, 0),
                    Visible = false,
                    ZIndex = 10,
                    ClipsDescendants = true,
                }, row)
                corner(optionFrame, 7)
                local optionLayout = create("UIListLayout", { Padding = UDim.new(0, 3) }, optionFrame)
                local function rebuild()
                    for _, child in ipairs(optionFrame:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    for index, option in ipairs(optionsList) do
                        local optionButton = button(optionFrame, tostring(option),
                            UDim2.new(1, -8, 0, 28), UDim2.fromOffset(4, (index - 1) * 31))
                        optionButton.ZIndex = 11
                        optionButton.Activated:Connect(function()
                            selected = option
                            main.Text = (controlOptions.Name or "Dropdown") .. ": " .. tostring(option)
                            optionFrame.Visible = false
                            optionFrame.Size = UDim2.new(1, 0, 0, 0)
                            row.Size = UDim2.new(1, 0, 0, 38)
                            if controlOptions.Callback then controlOptions.Callback(option) end
                        end)
                    end
                end
                rebuild()
                main.Activated:Connect(function()
                    local open = not optionFrame.Visible
                    optionFrame.Visible = open
                    optionFrame.Size = open and UDim2.new(1, 0, 0, math.min(#optionsList * 31 + 5, 155))
                        or UDim2.new(1, 0, 0, 0)
                    row.Size = UDim2.new(1, 0, 0, open and (43 + math.min(#optionsList * 31, 150)) or 38)
                end)
                return {
                    Instance = row,
                    GetValue = function() return selected end,
                    SetOptions = function(newOptions)
                        optionsList = newOptions or {}
                        rebuild()
                    end,
                    SetValue = function(newValue)
                        selected = newValue
                        main.Text = (controlOptions.Name or "Dropdown") .. ": " .. tostring(newValue or "Select")
                    end,
                }
            end

            function sectionObject:CreateLabel(controlOptions)
                local text = type(controlOptions) == "string" and controlOptions
                    or ((controlOptions and (controlOptions.Text or controlOptions.Name)) or "Label")
                local row = makeControl(controls, 34)
                local textLabel = label(row, text, UDim2.new(1, -16, 1, 0),
                    UDim2.fromOffset(8, 0), 13, Library.Theme.MutedText)
                return { Instance = row, Label = textLabel, SetText = function(newText) textLabel.Text = tostring(newText) end }
            end

            return sectionObject
        end

        -- Convenience methods so controls can be added directly to a tab.
        -- Each direct call gets its own small "Controls" section; for grouped
        -- layouts, create a section explicitly and add controls to that section.
        function tabObject:CreateButton(optionsForControl)
            return self:CreateSection({ Name = "Controls" }):CreateButton(optionsForControl)
        end
        function tabObject:CreateToggle(optionsForControl)
            return self:CreateSection({ Name = "Controls" }):CreateToggle(optionsForControl)
        end
        function tabObject:CreateSlider(optionsForControl)
            return self:CreateSection({ Name = "Controls" }):CreateSlider(optionsForControl)
        end
        function tabObject:CreateDropdown(optionsForControl)
            return self:CreateSection({ Name = "Controls" }):CreateDropdown(optionsForControl)
        end
        function tabObject:CreateLabel(optionsForControl)
            return self:CreateSection({ Name = "Controls" }):CreateLabel(optionsForControl)
        end

        tabButton.Activated:Connect(function()
            self._selectedTab = tabObject
            for _, existing in ipairs(self.Tabs) do
                existing.Page.Visible = existing == tabObject
                existing.Button.BackgroundColor3 = existing == tabObject
                    and Library.Theme.Accent or Library.Theme.SurfaceRaised
            end
        end)

        table.insert(self.Tabs, tabObject)
        if #self.Tabs == 1 then
            tabObject.Page.Visible = true
            tabButton.BackgroundColor3 = Library.Theme.Accent
            self._selectedTab = tabObject
        end
        return tabObject
    end

    function windowObject:Destroy()
        if gui then gui:Destroy() end
    end

    return windowObject
end

return Library
